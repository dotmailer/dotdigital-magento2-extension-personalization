<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template"
                   name="name_catcher"
                   template="Dotdigitalgroup_Personalization::data_layer.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Dotdigitalgroup\Personalization\ViewModel\DataLayer</argument>
                    <argument name="context" xsi:type="string">compare</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
