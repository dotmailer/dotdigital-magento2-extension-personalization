<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <dd_personalization_script>
            <general>
                <enable_fr_script>0</enable_fr_script>
                <account_id></account_id>
                <region>1</region>
                <script_hostname>ls.dycdn.net</script_hostname>
                <event_hostname>am.dycdn.net</event_hostname>
            </general>
        </dd_personalization_script>
        <dd_personalization_sync>
            <api>
                <connected>0</connected>
                <webhook_endpoint></webhook_endpoint>
                <access_token></access_token>
            </api>
        </dd_personalization_sync>
        <dd_personalization_data_layer>
            <data_layer>
                <enable_ddl>0</enable_ddl>
                <expose_on_all_pages>0</expose_on_all_pages>
                <expose_on_pages>catalog_product_view,checkout_cart_index,checkout_index_index</expose_on_pages>
                <expose_custom_handles></expose_custom_handles>
                <purchase_complete_handles></purchase_complete_handles>
                <enable_user_group>0</enable_user_group>
            </data_layer>
            <product_data>
                <product_attributes></product_attributes>
                <stock_level>0</stock_level>
                <enable_ratings>0</enable_ratings>
                <enable_linked_products>1</enable_linked_products>
                <enable_parent_products>0</enable_parent_products>
            </product_data>
        </dd_personalization_data_layer>
    </default>
</config>
