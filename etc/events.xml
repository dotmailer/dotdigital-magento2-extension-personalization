<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="dd_personalization_product_save" instance="Dotdigitalgroup\Personalization\Observer\Webhooks\ProductSave" />
    </event>
    <event name="catalog_product_attribute_update_before">
        <observer name="dd_personalization_product_bulk_status_change" instance="Dotdigitalgroup\Personalization\Observer\Webhooks\ProductBulkStatusChange" />
    </event>
    <event name="checkout_cart_add_product_complete">
        <observer name="dd_personalization_cart_update" instance="Dotdigitalgroup\Personalization\Observer\Webhooks\CartUpdate" />
    </event>
</config>
